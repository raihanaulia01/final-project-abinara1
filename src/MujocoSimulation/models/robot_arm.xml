<mujoco model="robot_arm">
  <default>
    <default class="robot">
      <default class="visual">
        <geom contype="0" conaffinity="0" group="2" />
      </default>
      <default class="collision">
        <geom contype="0" conaffinity="1" group="3" />
      </default>
    </default>

    <default class="floor">
      <geom type="plane" size="0 0 0.05" material="groundplane" />
    </default>

    <default class="block_visual">
      <geom type="mesh" mesh="target_block" contype="0" conaffinity="0" group="1" mass="0.03"/>
    </default>

    <default class="block_col">
      <geom group="3" contype="1" conaffinity="1" density="0" friction="1 0.005 0.0001" rgba="1 0 0 0.3"/>
    </default>
  </default>

  <option
    timestep="0.001"
    iterations="100"
    solver="Newton"
    gravity="0 0 -9.81"/>

  <compiler angle="radian" meshdir="../../robot_arm/meshes" balanceinertia="true" />

  <visual>
    <global offwidth="3840" offheight="2160" />
  </visual>

