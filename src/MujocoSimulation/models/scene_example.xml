<mujoco model="pyramid_arm">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <visual>
    <global offwidth="640" offheight="480"/>
    <headlight ambient="0.55 0.55 0.55" diffuse="0.45 0.45 0.45" specular="0 0 0"/>
    <quality shadowsize="0"/>
  </visual>

  <default>
    <joint damping="2" limited="true"/>
    <geom contype="0" conaffinity="0" rgba="0.25 0.25 0.3 1"/>
  </default>

  <worldbody>
    <light pos="0.2 0 1.5" dir="0 0 -1" diffuse="0.5 0.5 0.5" castshadow="false"/>

    <geom name="table" type="plane" size="0.8 0.8 0.01" pos="0 0 0" rgba="0.35 0.35 0.35 1"
          contype="1" conaffinity="1" friction="1 0.005 0.0001"/>

    <camera name="arena_cam" pos="0.20 0 0.60" xyaxes="0 -1 0 1 0 0" fovy="55"/>

    <body name="base_link" pos="0 0 0">
      <geom type="cylinder" size="0.05 0.04" pos="0 0 0.04"/>
      <body name="yaw_link" pos="0 0 0">
        <joint name="base" type="hinge" axis="0 0 1" range="-1.5708 1.5708"/>
        <geom type="cylinder" size="0.03 0.04" pos="0 0 0.06"/>
        <body name="shoulder_link" pos="0 0 0.08">
          <joint name="shoulder" type="hinge" axis="0 -1 0" range="0 3.1416"/>
          <geom type="capsule" size="0.015" fromto="0 0 0 0.20 0 0"/>
          <body name="elbow_link" pos="0.20 0 0">
            <joint name="elbow" type="hinge" axis="0 -1 0" range="-2.618 0.5236"/>
            <geom type="capsule" size="0.013" fromto="0 0 0 0.20 0 0"/>
            <body name="wrist_link" pos="0.20 0 0">
              <joint name="wrist" type="hinge" axis="0 -1 0" range="-2.0944 2.0944"/>
              <geom type="capsule" size="0.012" fromto="0 0 0 0.07 0 0"/>
              <site name="tool_tip" pos="0.10 0 0" size="0.006" rgba="1 0 0 1"/>
              <body name="finger_l" pos="0.08 0.03 0">
                <joint name="finger_l" type="slide" axis="0 -1 0" range="0 0.025" damping="5"/>
                <geom type="box" size="0.02 0.004 0.01"/>
              </body>
              <body name="finger_r" pos="0.08 -0.03 0">
                <joint name="finger_r" type="slide" axis="0 1 0" range="0 0.025" damping="5"/>
                <geom type="box" size="0.02 0.004 0.01"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <body name="block_orange_1" pos="0.25 0.05 0.0125"><freejoint/>
      <geom type="box" size="0.03 0.015 0.0125" rgba="1.0 0.5 0.0 1" mass="0.03" contype="1" conaffinity="1"/></body>
    <body name="block_orange_2" pos="0.20 -0.12 0.0125"><freejoint/>
      <geom type="box" size="0.03 0.015 0.0125" rgba="1.0 0.5 0.0 1" mass="0.03" contype="1" conaffinity="1"/></body>
    <body name="block_orange_3" pos="0.28 -0.10 0.0125"><freejoint/>
      <geom type="box" size="0.03 0.015 0.0125" rgba="1.0 0.5 0.0 1" mass="0.03" contype="1" conaffinity="1"/></body>
    <body name="block_green_1" pos="0.18 0.14 0.0125"><freejoint/>
      <geom type="box" size="0.03 0.015 0.0125" rgba="0.0 0.75 0.3 1" mass="0.03" contype="1" conaffinity="1"/></body>
    <body name="block_green_2" pos="0.30 0.12 0.0125"><freejoint/>
      <geom type="box" size="0.03 0.015 0.0125" rgba="0.0 0.75 0.3 1" mass="0.03" contype="1" conaffinity="1"/></body>
    <body name="block_beige_1" pos="0.22 0.0 0.0125"><freejoint/>
      <geom type="box" size="0.03 0.015 0.0125" rgba="0.93 0.88 0.78 1" mass="0.03" contype="1" conaffinity="1"/></body>
  </worldbody>

  <equality>
    <joint joint1="finger_l" joint2="finger_r"/>
  </equality>

  <actuator>
    <position name="base"     joint="base"     kp="40" ctrlrange="-1.5708 1.5708"/>
    <position name="shoulder" joint="shoulder" kp="40" ctrlrange="0 3.1416"/>
    <position name="elbow"    joint="elbow"    kp="40" ctrlrange="-2.618 0.5236"/>
    <position name="wrist"    joint="wrist"    kp="40" ctrlrange="-2.0944 2.0944"/>
    <position name="gripper"  joint="finger_l" kp="200" ctrlrange="0 0.025"/>
  </actuator>
</mujoco>
